# Keep source files deterministic across Windows/macOS/Linux.
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.svg text eol=lf
src/uniti/ui/assets/lucide/LICENSE text eol=lf
*.bat text eol=crlf

# UNITI's future byte/EOL/encoding fixtures must never be rewritten by Git.
tests/fixtures/** -text

# Pinned font payload and upstream notices retain exact SHA-256 on every host.
src/uniti/ui/assets/fonts/*.otf binary
src/uniti/ui/assets/fonts/licenses/* -text
src/uniti/ui/assets/fonts/manifest.json text eol=lf
# Upstream OFL text is byte-pinned, including original trailing whitespace.
src/uniti/ui/assets/fonts/licenses/* whitespace=-blank-at-eol,-blank-at-eof
